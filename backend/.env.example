APP_NAME="Kovir ERP API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
UVICORN_LOG_LEVEL="info"
LOG_FORMAT="json"

# Desenvolvimento local:
# - Use POSTGRES_* para montar a conexao automaticamente.
# - O helper Docker local do PostgreSQL usa a porta 5433 no host para nao
#   conflitar com outros projetos que usem 5432.
# - Nao deixe DATABASE_URL ativo com placeholder invalido.
POSTGRES_DB="kovir_erp"
POSTGRES_USER="kovir_erp_app"
POSTGRES_PASSWORD="preencha_uma_senha_local_forte"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5433"

# Local opcional, somente se quiser sobrescrever POSTGRES_*:
# DATABASE_URL="postgresql+psycopg://kovir_erp_app:<senha>@localhost:5433/kovir_erp"

# Variaveis lidas pelo backend/docker-compose.yml para subir somente o PostgreSQL.
# Mantenha estes valores alinhados com POSTGRES_* ou com DATABASE_URL.
KOVIR_ERP_POSTGRES_DB="kovir_erp"
KOVIR_ERP_POSTGRES_USER="kovir_erp_app"
KOVIR_ERP_POSTGRES_PASSWORD="preencha_a_mesma_senha_local_forte"
KOVIR_ERP_POSTGRES_HOST_PORT="5433"

# Producao futura (nao ativa no Marco Zero local):
# - ENVIRONMENT="production"
# - DEBUG=false
# - LOG_FORMAT="json"
# - UVICORN_LOG_LEVEL="info"
# - DATABASE_URL obrigatorio, apontando para PostgreSQL remoto seguro.
# - Usar usuario da aplicacao, nunca usuario master/superuser.
# - Usar porta 5432 e TLS obrigatorio com sslmode=require ou sslmode=verify-full.
# - Nunca versionar usuario, senha, endpoint real ou secrets.
# - Migrations Alembic devem ser etapa controlada de deploy, nao startup automatico.
# - SECRET_ENCRYPTION_KEY obrigatorio. Gere localmente com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# - AUTO_MIGRATE_ON_STARTUP=false
# - DDL_FALLBACK_ENABLED=false
# - ENABLE_INTERNAL_MODULES=false
# - BOOTSTRAP_ADMIN_ENABLED=false
# - CORS_ALLOWED_ORIGINS deve conter apenas dominios reais do Kovir ERP.
# - CORS_ALLOW_ORIGIN_REGEX deve ficar vazio
# - SECURITY_HEADERS_ENABLED=true
# - HSTS_ENABLED=true somente quando HTTPS estiver ativo e validado.
# Exemplo futuro generico:
# ENVIRONMENT="production"
# DEBUG=false
# LOG_FORMAT="json"
# UVICORN_LOG_LEVEL="info"
# DATABASE_URL="postgresql+psycopg://<usuario_app>:<senha>@<host-postgres>:5432/<database>?sslmode=require"
# CORS_ALLOWED_ORIGINS="https://erp.exemplo.com.br"
# CORS_ALLOW_ORIGIN_REGEX=""
# HSTS_ENABLED=true
AUTO_MIGRATE_ON_STARTUP=false
DDL_FALLBACK_ENABLED=false
ENABLE_INTERNAL_MODULES=false

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_TOKEN=""
SECRET_ENCRYPTION_KEY=""

CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
CORS_ALLOW_ORIGIN_REGEX=""

MAX_REQUEST_BODY_BYTES=10485760
SECURITY_HEADERS_ENABLED=true
CSP_REPORT_ONLY=false
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=15552000

FOCUS_NFE_TOKEN=""
FOCUS_NFE_ENVIRONMENT="homologacao"

