# Frontend local/producao futura
#
# Variaveis VITE_* entram no bundle do navegador.
# Nunca coloque secrets, tokens, senhas, chaves privadas ou strings de banco aqui.

# Padrao recomendado:
# - Local: Vite proxy encaminha /api para http://127.0.0.1:8000.
# - Producao futura: mesma origem em /api por proxy/reverse proxy validado.
# - Build de producao falha se VITE_API_BASE_URL apontar para localhost, HTTP inseguro ou tunel temporario.
VITE_API_BASE_URL="/api"

# Apenas para o servidor dev do Vite.
VITE_ALLOWED_HOSTS="localhost,127.0.0.1"

# Modulos internos nao entram na v1.0 comercial.
# Em build de producao, true e bloqueado pelo Vite.
VITE_ENABLE_INTERNAL_MODULES=false

# Opcional local/demo. Em producao, a empresa ativa deve vir da sessao/autorizacao.
# Em build de producao, qualquer valor preenchido e bloqueado pelo Vite.
VITE_ACTIVE_COMPANY_ID=""
